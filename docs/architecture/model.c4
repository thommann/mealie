        }
        user_services = subpkg 'mealie.user_services' {
          password_reset_service = mod 'mealie.services.user_services.password_reset_service'
          registration_service = mod 'mealie.services.user_services.registration_service'
          user_service = mod 'mealie.services.user_services.user_service'
        }
      }
    }

    database = container 'Database' 'SQLite (default, WAL pragma) or PostgreSQL.' {
      #datastore
    }

    alembic = container 'Alembic migrations' 'Versioned schema migrations under mealie/alembic/versions (run on startup via init_db.main()).'

    nltkData = container 'NLTK data' 'Tokenizer/corpora used by recipe ingredient parser.'

    scheduler = container 'In-process scheduler' 'Asyncio scheduler running daily/hourly/minutely tasks inside the backend worker.'
  }

  // ====== System Context relationships ======
  user -> mealie.frontend 'Uses (browser, HTTPS)'
  user -> mealie.backend 'Direct API access (HTTPS / JSON / SSE)'
  mealie.backend -> recipeWebsite 'Scrapes recipe HTML (HTTPS)'
  mealie.backend -> openai 'AI-assisted scraping (HTTPS)'
  mealie.backend -> smtp 'Sends email'
  mealie.backend -> ldap 'Authenticates users (optional)'
  mealie.backend -> oidc 'Authenticates users (optional)'
  mealie.backend -> apprise 'Publishes domain events'
  mealie.backend -> webhookTarget 'Posts group webhooks'

  // ====== Container relationships ======
  mealie.frontend -> mealie.backend 'JSON / SSE over HTTPS'
  mealie.backend -> mealie.database 'SQLAlchemy 2.0 (sync session)'
  mealie.backend -> mealie.alembic 'Runs migrations on startup'
  mealie.alembic -> mealie.database 'DDL'
  mealie.backend -> mealie.nltkData 'Loads tokenizer/corpora'
  mealie.backend -> mealie.scheduler 'Hosts'
  mealie.scheduler -> mealie.backend 'Invokes scheduled tasks'

