// Historical snapshot captured 2026-05-03, before the ADR-0001 refactor landed.
// At that point `mealie.services.scheduler.tasks.delete_old_checked_shopping_list_items`
// imported `publish_list_item_events` from `mealie.routes.households.controller_shopping_lists`,
// dragging the FastAPI/CBV stack into the scheduler. The helper has since been
// extracted to `mealie.services.household_services.shopping_list_events` and the
// `services -> routes` edge no longer exists; see `target.view.c4` for the
// post-refactor state and ADR-0001 for the decision.
// Kept for historical reference only — do NOT treat this view as current.
// Specification and model elements are declared in ../spec.c4 and ../model.c4
// and reused by FQN here.

specification {
  tag violation
}

model {
  // External heavy transitive dep that leaks into the scheduler when the
  // services layer reaches into routes. Declared once for both layering views.
  fastapi = ext 'FastAPI + CBV stack' 'HTTP framework, BaseCrudController, HttpRepo, APIRouter — pulled transitively when services imports routes.'

  // Tag the existing violating edge so the view can style it.
  extend mealie.backend.services.scheduler.tasks.delete_old_checked_shopping_list_items
    -> mealie.backend.routes.households.controller_shopping_lists {
    #violation
  }

  // Surface the transitive leak as a model edge: the controller drags the
  // FastAPI/CBV stack into anything that imports it.
  mealie.backend.routes.households.controller_shopping_lists -> fastapi 'transitively imports'
}

views {
  view layering_historical {
    title 'Layering — historical pre-ADR-0001 (violation, captured 2026-05-03)'
    description '''
      Today: the scheduler task imports `publish_list_item_events` from the
      shopping-list controller. That single edge drags the entire FastAPI/CBV
      stack into a process loop that only needs to broadcast events. See
      ADR-0001.
    '''

    include mealie.backend.services.scheduler.tasks.delete_old_checked_shopping_list_items
    include mealie.backend.routes.households.controller_shopping_lists
    include mealie.backend.services.household_services.shopping_lists
    include mealie.backend.services.event_bus_service.event_types
    include mealie.backend.schema.household.group_shopping_list
    include mealie.backend.routes.households
    include fastapi

    include
      * -> *
      where tag is #violation
      with {
        color red
        line solid
      }

    autoLayout TopBottom
  }
}
